<Window x:Class="SkyDNS.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyDNS"
        Title="SkyDNS Widget" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" FlowDirection="{Binding Flow}"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{StaticResource Pane}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SkySoftBorder}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource SkySoft}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Sky}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="20" Background="{StaticResource Cloud}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16"
          MouseLeftButtonDown="Drag">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.2" Color="#0A2A55"/></Border.Effect>
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Sky}" VerticalAlignment="Center"/>
          <TextBlock Text="{local:T appName}" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource BtnIcon}" Width="26" Height="26" FontSize="12" Foreground="{StaticResource Muted}" Content="&#xE8A7;" ToolTip="{local:T open}" Click="Open_Click"/>
          <Button Style="{StaticResource BtnIcon}" Width="26" Height="26" FontSize="10" Foreground="{StaticResource Muted}" Content="&#xE8BB;" ToolTip="{local:T close}" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <Border Margin="0,12,0,10" Padding="14" CornerRadius="12" BorderThickness="1" Background="{Binding WidgetBg}" BorderBrush="{Binding WidgetBorder}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{Binding StatusDot}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TrayStatus}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="6,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Text="{Binding WidgetName}" FontSize="18" FontWeight="Medium" Margin="0,3,0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding WidgetSub}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
          </StackPanel>
          <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AnyActive, Mode=OneWay}" Click="Toggle_Click" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Servers}" Margin="-4,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:DnsEntry}">
            <Button Style="{StaticResource Tile}" Click="Tile_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{Binding ColorBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding PingText}" FontSize="10.5" Foreground="{Binding PingBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
