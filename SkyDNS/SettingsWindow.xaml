<Window x:Class="SkyDNS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyDNS"
        Title="SkyDNS" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" FlowDirection="{Binding Flow}"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SwitchRow" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
      <Setter Property="Padding" Value="0"/>
    </Style>
  </Window.Resources>

  <Border Margin="20" Background="{StaticResource Cloud}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#0A2A55"/></Border.Effect>
    <StackPanel>
      <Grid Height="42" Background="Transparent" MouseLeftButtonDown="Drag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Sky}" VerticalAlignment="Center"/>
          <TextBlock Text="{local:T settings}" FontSize="13" FontWeight="Medium" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Margin="0,0,8,0" FontSize="11" Foreground="{StaticResource Muted}" Content="&#xE8BB;" IsCancel="True" Click="Close_Click"/>
      </Grid>
      <Border Height="1" Background="{StaticResource Line}"/>

      <StackPanel Margin="26,22,26,26">
        <TextBlock Text="{local:T adapterTitle}" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Text="{local:T adapterDesc}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,10"/>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="4,4,4,0">
          <ListBox ItemsSource="{Binding AdapterOptions}" SelectedItem="{Binding SelectedAdapter}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="240"
                   ItemContainerStyle="{StaticResource Row}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:AdapterOption}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="dot" Width="16" Height="16" Stroke="#9AA6B5" StrokeThickness="1.5" Fill="{StaticResource Cloud}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="dot" Property="Stroke" Value="{StaticResource Sky}"/>
                    <Setter TargetName="dot" Property="StrokeThickness" Value="5"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <TextBlock Text="{local:T general}" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,10"/>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <Border Padding="14,11">
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupEnabled}">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{local:T startup}" FontSize="13"/>
                  <TextBlock Text="{local:T startupD}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
            </Border>
            <Border Padding="14,11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{local:T tray}" FontSize="13"/>
                  <TextBlock Text="{local:T trayD}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
            </Border>
            <Border Padding="14,11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FlushAfterSwitch}">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{local:T flush}" FontSize="13"/>
                  <TextBlock Text="{local:T flushD}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
            </Border>
            <Border Padding="14,11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RestoreOnExit}">
                <TextBlock Text="{local:T restore}" FontSize="13" Margin="0,0,12,0"/>
              </CheckBox>
            </Border>
            <Border Padding="14,11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PingOnLaunch}">
                <TextBlock Text="{local:T pingLaunch}" FontSize="13" Margin="0,0,12,0"/>
              </CheckBox>
            </Border>
            <Border Padding="14,11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdates}">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{local:T checkUpd}" FontSize="13"/>
                  <TextBlock Text="{local:T checkUpdD}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
            </Border>
            <Border Padding="14,8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0" FontSize="12" Click="CheckNow_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{local:T checkNow}"/>
                  </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding AppVersion}" FontSize="13"/>
                  <TextBlock Text="{Binding UpdateStatus}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{local:T language}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Background="{StaticResource PaneHover}" CornerRadius="9" Padding="3">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Seg}" GroupName="lang" Content="فارسی" IsChecked="{Binding IsFa}"/>
              <RadioButton Style="{StaticResource Seg}" GroupName="lang" Content="English" IsChecked="{Binding IsEn}" Margin="2,0,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
