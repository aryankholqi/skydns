<Window x:Class="SkyDNS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyDNS"
        Title="SkyDNS" Width="980" Height="640" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Cloud}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource UiFont}" FlowDirection="{Binding Flow}"
        UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="WorldMap.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ServerItem" TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_Click"/>
      <EventSetter Event="KeyDown" Handler="Item_KeyDown"/>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- Title bar -->
      <Grid Grid.ColumnSpan="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
          <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource Sky}">
            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Cloud}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{local:T appName}" Margin="10,0,0,0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource Caption}" Content="&#xE8A9;" FontSize="12" ToolTip="{local:T widget}" Click="Widget_Click"/>
          <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Min_Click"/>
          <Button x:Name="MaxBtn" Style="{StaticResource Caption}" Content="&#xE922;" Click="Max_Click"/>
          <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <!-- Sidebar -->
      <Border Grid.Row="1" Background="{StaticResource Pane}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
        <DockPanel Margin="12,14,12,10">
          <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{local:T servers}" FontSize="14" FontWeight="SemiBold"/>
              <Border Background="{StaticResource Chip}" CornerRadius="10" Padding="8,1" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Servers.Count}" FontSize="11" Foreground="{StaticResource Muted}"/>
              </Border>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" BorderBrush="{StaticResource SkySoftBorder}" Foreground="{StaticResource Sky}"
                    Content="&#xE710;" ToolTip="{local:T add}" Click="Add_Click"/>
          </Grid>

          <!-- Built-in instant DNS entry (always pinned, not part of the saved list) -->
          <Button DockPanel.Dock="Top" Margin="0,0,0,10" Height="Auto" Padding="10,8" HorizontalContentAlignment="Stretch" Click="Instant_Click">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsInstant}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SkySoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SkySoftBorder}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Sky}">
                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource Cloud}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{local:T instant}" FontSize="13" FontWeight="Medium"/>
                  <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Sky}" Margin="6,0" VerticalAlignment="Center"
                             Visibility="{Binding Instant.IsActive, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Instant.Primary}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
          </Button>

          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Style="{StaticResource Input}" Height="34" Padding="32,0,10,0" FontSize="12.5"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Muted}"
                       Margin="12,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock Text="{local:T search}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="33,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Visibility="{Binding SearchEmpty, Converter={StaticResource BoolVis}}"/>
          </Grid>

          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Height="32" Padding="10,0" FontSize="12" Click="TestAll_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding TestAllLabel}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" Height="32" Padding="8,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="{local:T settings}" FontSize="12.5"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Text="{local:T hint}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,8,4,8"/>

          <ListBox x:Name="List" ItemsSource="{Binding ServersView}" SelectedItem="{Binding Selected}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemContainerStyle="{StaticResource ServerItem}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:DnsEntry}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="{Binding SoftBrush}">
                    <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{Binding ColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                      <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Sky}" Margin="6,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Primary}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Ellipse Width="6" Height="6" Fill="{Binding PingBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PingText}" FontSize="11" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Detail -->
      <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid>
        <!-- Instant DNS page -->
        <StackPanel Margin="34,28,34,22" Visibility="{Binding IsInstant, Converter={StaticResource BoolVis}}">
          <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Sky}">
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource Cloud}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0" VerticalAlignment="Center">
              <TextBlock Text="{local:T instant}" FontSize="24" FontWeight="Medium"/>
              <TextBlock Text="{local:T instantD}" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>

          <Border Margin="0,22,0,0" Padding="24,22" CornerRadius="12" BorderThickness="1" Background="{Binding HeroBg}" BorderBrush="{Binding HeroBorder}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusDot}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="Medium" Margin="8,0"/>
              </StackPanel>
              <TextBlock Text="{Binding StatusDesc}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18" LineHeight="20"/>

              <UniformGrid Columns="2" Margin="-6,0">
                <StackPanel Margin="6,0">
                  <TextBlock Text="{local:T primary}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                  <TextBox Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" KeyDown="InstantInput_KeyDown"
                           Text="{Binding InstantPrimary, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="6,0">
                  <TextBlock Text="{local:T secondary}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                  <TextBox Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" KeyDown="InstantInput_KeyDown"
                           Text="{Binding InstantSecondary, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="{Binding InstantError}" FontSize="12" Foreground="{StaticResource Danger}" Margin="0,8,0,0"/>

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource BtnPrimary}" Padding="18,0" Click="InstantApply_Click" IsEnabled="{Binding NotApplying}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{local:T apply}"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnSecondary}" Padding="18,0" Margin="8,0" Click="Disconnect_Click"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{local:T disconnect}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid Margin="34,28,34,22" IsEnabled="{Binding HasSelection}" Visibility="{Binding NotInstant, Converter={StaticResource BoolVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="{Binding Selected.SoftBrush}">
              <TextBlock Text="{Binding Selected.IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{Binding Selected.ColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
              <TextBlock Text="{local:T current}" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="{Binding Selected.Name}" FontSize="24" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Height="32" Padding="12,0" VerticalAlignment="Top" FontSize="12" Click="Adapter_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AdapterGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Sky}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AdapterLabel}" Margin="8,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1" Margin="0,22,0,0" Padding="24,22" CornerRadius="12" BorderThickness="1"
                  Background="{Binding HeroBg}" BorderBrush="{Binding HeroBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Button Width="124" Height="124" Margin="10" Style="{StaticResource PowerBtn}" Click="Toggle_Click"/>
              <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusDot}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="Medium" Margin="8,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusDesc}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" Margin="0,8,0,14" LineHeight="20"/>
                <Button HorizontalAlignment="Left" Padding="18,0" Click="Toggle_Click">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                          <Setter Property="Background" Value="{StaticResource Cloud}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CtaGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding CtaLabel}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <UniformGrid Grid.Row="2" Columns="3" Margin="-6,12,-6,0">
            <Border Margin="6" Padding="16,14" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" x:Name="CopyP" Style="{StaticResource BtnIcon}" Width="24" Height="24" FontSize="12" Foreground="{StaticResource Muted}" Content="&#xE8C8;" Click="CopyP_Click"/>
                  <TextBlock Text="{local:T primary}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding Selected.Primary}" FontFamily="{StaticResource MonoFont}" FontSize="17" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Margin="6" Padding="16,14" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" x:Name="CopyS" Style="{StaticResource BtnIcon}" Width="24" Height="24" FontSize="12" Foreground="{StaticResource Muted}" Content="&#xE8C8;" Click="CopyS_Click"/>
                  <TextBlock Text="{local:T secondary}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding Selected.SecondaryText}" FontFamily="{StaticResource MonoFont}" FontSize="17" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Margin="6" Padding="16,14" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <DockPanel Height="24">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Quality}" FontSize="11" Foreground="{Binding Selected.PingBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{local:T latency}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,8" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Selected.PingNum}" FontSize="22" FontWeight="Medium"/>
                  <TextBlock Text="ms" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,0,0,4" VerticalAlignment="Bottom"/>
                </StackPanel>
                <ProgressBar Style="{StaticResource Bar}" Maximum="200" Value="{Binding Selected.PingValue, Mode=OneWay}" Foreground="{Binding Selected.PingBrush}"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Public IP + location map -->
          <Border Grid.Row="3" Margin="0,12,0,16" Padding="16,12" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" Width="24" Height="24" FontSize="12" Foreground="{StaticResource Muted}"
                          Content="&#xE72C;" ToolTip="{local:T refresh}" Click="Geo_Click"/>
                  <TextBlock Text="{local:T yourIp}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding GeoIp}" FontFamily="{StaticResource MonoFont}" FontSize="17" Margin="0,6,0,0" FlowDirection="LeftToRight"
                           HorizontalAlignment="{Binding Flow, Converter={x:Static local:FlowAlign.I}}"/>
                <TextBlock Text="{Binding GeoPlace}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GeoIsp}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <!-- map is geographic: never mirror it in RTL -->
              <Viewbox Grid.Column="1" Margin="12,0,0,0" FlowDirection="LeftToRight">
                <Canvas Width="360" Height="144" ClipToBounds="True">
                  <Path Data="{StaticResource WorldLand}" Fill="{StaticResource Chip}" Stroke="{StaticResource SkySoftBorder}" StrokeThickness="0.3"/>
                  <Canvas Canvas.Left="{Binding PinX}" Canvas.Top="{Binding PinY}"
                          Visibility="{Binding HasGeo, Converter={StaticResource BoolVis}}">
                    <Ellipse Width="6" Height="6" Margin="-3,-3,0,0" Fill="{StaticResource Sky}" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform>
                        <ScaleTransform/>
                      </Ellipse.RenderTransform>
                      <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="4.5" Duration="0:0:1.6"/>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="4.5" Duration="0:0:1.6"/>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Margin="-3,-3,0,0" Fill="{StaticResource Sky}" Stroke="{StaticResource Cloud}" StrokeThickness="1"/>
                  </Canvas>
                </Canvas>
              </Viewbox>
            </Grid>
          </Border>

          <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Foreground="{StaticResource Danger}" Height="32" Padding="12,0" FontSize="12.5" Click="Delete_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{local:T del}"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BtnOutline}" Height="32" FontSize="12.5" Click="Test_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding TestLabel}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Btn}" Height="32" FontSize="12.5" Margin="8,0,0,0" Click="Edit_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="{local:T edit}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
