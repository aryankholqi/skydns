<Window x:Class="SkyDNS.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyDNS"
        Title="SkyDNS" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" FlowDirection="{Binding Flow}"
        UseLayoutRounding="True">
  <Border Margin="20" Background="{StaticResource Cloud}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#0A2A55"/></Border.Effect>
    <StackPanel>
      <Grid Margin="22" Background="Transparent" MouseLeftButtonDown="Drag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SkySoft}" VerticalAlignment="Top">
          <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Sky}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Medium" TextWrapping="Wrap"/>
          <TextBlock x:Name="DescText" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
          <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Maximum="1" Margin="0,14,0,0" Foreground="{StaticResource Sky}" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <Border Background="{StaticResource Pane}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="LaterBtn" Style="{StaticResource BtnSecondary}" Content="{local:T later}" IsCancel="True"/>
          <Button x:Name="InstallBtn" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Padding="20,0" Click="Install_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="{local:T install}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
