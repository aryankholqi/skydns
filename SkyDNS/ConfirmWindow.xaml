<Window x:Class="SkyDNS.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyDNS"
        Title="SkyDNS" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}" FlowDirection="{Binding Flow}"
        UseLayoutRounding="True">
  <Border Margin="20" Background="{StaticResource Cloud}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#0A2A55"/></Border.Effect>
    <StackPanel>
      <Grid Margin="22,22,22,22" Background="Transparent" MouseLeftButtonDown="Drag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="10" Background="#1AD33A3F" VerticalAlignment="Top">
          <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Danger}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="MessageText" Grid.Column="1" Margin="14,0,0,0" FontSize="15" FontWeight="Medium"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Grid>

      <Border Background="{StaticResource Pane}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelBtn" Style="{StaticResource BtnSecondary}" Content="{local:T cancel}" IsCancel="True"/>
          <Button Style="{StaticResource BtnPrimary}" Background="{StaticResource Danger}" BorderBrush="{StaticResource Danger}"
                  Margin="8,0,0,0" Padding="20,0" Click="Ok_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="{local:T del}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
